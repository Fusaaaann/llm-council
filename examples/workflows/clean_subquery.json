{
  "flow_id": "clean_subquery_example",
  "global_timeout_ms": 120000,
  "variables": [
    {
      "name": "fresh_perspective",
      "type": "string"
    }
  ],
  "supersteps": [
    {
      "step_id": "clean_subquery",
      "description": "Get a fresh, unbiased perspective without any context",
      "map_phase": {
        "workers": []
      },
      "reduce_phase": {
        "strategy": "subquery_single_model",
        "model_ref": "anthropic/claude-3.5-sonnet",
        "output_write_to": "fresh_perspective",
        "visibility": {
          "include_original_input": true,
          "include_conversation_history": false,
          "include_worker_outputs": false,
          "mask_worker_identities": true
        },
        "chairman_instructions": "Provide a thoughtful, unbiased analysis of the question without any prior context or discussion."
      }
    }
  ]
}
