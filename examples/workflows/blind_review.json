{
  "flow_id": "blind_review",
  "global_timeout_ms": 180000,
  "variables": [
    {
      "name": "final_answer",
      "type": "string"
    }
  ],
  "supersteps": [
    {
      "step_id": "gather_responses",
      "description": "Collect responses from multiple models",
      "map_phase": {
        "perspectives": [
          {
            "perspective_id": "model_a",
            "instruction": "Answer the user's question comprehensively and accurately.",
            "model_ref": "openai/gpt-4"
          },
          {
            "perspective_id": "model_b",
            "instruction": "Answer the user's question comprehensively and accurately.",
            "model_ref": "anthropic/claude-3.5-sonnet"
          },
          {
            "perspective_id": "model_c",
            "instruction": "Answer the user's question comprehensively and accurately.",
            "model_ref": "google/gemini-2.0-flash-exp"
          }
        ]
      },
      "reduce_phase": {
        "strategy": "council_chairman",
        "model_ref": "openai/gpt-4-turbo",
        "output_write_to": "final_answer",
        "visibility": {
          "include_original_input": true,
          "mask_worker_identities": true,
          "include_rejected_items": false,
          "include_conversation_history": true,
          "include_worker_outputs": true
        },
        "chairman_instructions": "Evaluate the responses without knowing which model produced them. Focus purely on the quality, accuracy, and completeness of the content. Synthesize the best aspects of each response into a comprehensive final answer."
      }
    }
  ]
}