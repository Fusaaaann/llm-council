# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Environment Mode
# Options: "local" or "production"
# Local: Authentication optional, uses default profile
# Production: Authentication required
ENVIRONMENT=local

# Default Profile (Local Mode Only)
DEFAULT_PROFILE_ID=default

# Encryption Settings
# Enable/disable encryption at rest for conversations AND auth data
ENCRYPTION_ENABLED=true

# Encryption key for Fernet symmetric encryption (AES-128-CBC)
# Generate with: python scripts/generate_encryption_key.py
# IMPORTANT: Back up this key! Lost key = lost conversations AND user data
# Used for: conversation messages, user data, sessions, invite tokens
ENCRYPTION_KEY=your_base64_fernet_key_here

# Authentication Settings
# JWT secret key for token signing
# CRITICAL: Must be set in production mode! Auto-generated in local mode only.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY=your_jwt_secret_key_here

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Enable authentication (set to "true" for production)
AUTH_ENABLED=false

# Account Security Settings
# Maximum failed login attempts before account lockout
ACCOUNT_LOCKOUT_THRESHOLD=10

# Account lockout duration in minutes
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Waitlist & Invite Settings
# Admin email to receive waitlist notifications (future feature)
ADMIN_EMAIL=admin@example.com

# Invite token expiration in days
INVITE_TOKEN_EXPIRE_DAYS=7

# Base URL for API (used in invite emails, etc.)
API_BASE_URL=http://localhost:5173

# Security Notes:
# 1. ENCRYPTION_KEY: Protects all sensitive data at rest. MUST be backed up!
# 2. JWT_SECRET_KEY: Required for production. Server will fail to start without it.
# 3. Rate limiting: Built-in for all auth endpoints (no config needed)
# 4. Audit logging: Automatic to data/audit.log (no config needed)
# 5. Security headers: Automatic (CSP, HSTS, X-Frame-Options, etc.)