{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/dsl-flow.schema.json",
  "title": "Anonymized Multi-Turn Conversation Flow (BSP Architecture)",
  "description": "Defines a directed graph of Bulk Synchronous Parallel supersteps for orchestration of multiple LLM agents.",
  "type": "object",
  "required": ["flow_id", "supersteps"],
  "properties": {
    "flow_id": {
      "type": "string",
      "description": "Unique identifier for this conversation topology."
    },
    "global_timeout_ms": {
      "type": "integer",
      "default": 60000,
      "description": "Hard cutoff for the entire execution to prevent hung processes."
    },
    "models": {
      "type": "array",
      "description": "Global list of models available for this workflow. Referenced by perspective_matrix or individual workers.",
      "items": { "type": "string" }
    },
    "variables": {
      "type": "array",
      "description": "The 'Memory' of the flow. These are the keys that can be read/written by Reducers.",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "json_object", "list"] },
          "default_value": { "type": ["string", "object", "array", "null"] }
        }
      }
    },
    "supersteps": {
      "type": "array",
      "description": "The sequence of synchronized steps. Each step MUST complete before the next begins.",
      "items": { "$ref": "#/definitions/Superstep" }
    }
  },
  "definitions": {
    "Superstep": {
      "type": "object",
      "required": ["step_id", "map_phase", "reduce_phase"],
      "properties": {
        "step_id": {
          "type": "string",
          "description": "Unique ID for logging and transitioning."
        },
        "description": {
          "type": "string",
          "description": "Human-readable intent (e.g., 'Gather initial perspectives')."
        },
        
        "// PHASE 1": { "description": "---------------- MAP ----------------" },
        "map_phase": {
          "type": "object",
          "oneOf": [
            {
              "required": ["workers"],
              "not": { "required": ["perspective_matrix"] }
            },
            {
              "required": ["perspective_matrix"],
              "not": { "required": ["workers"] }
            }
          ],
          "properties": {
            "concurrency_limit": {
              "type": "integer",
              "description": "Max parallel goroutines allowed."
            },
            "global_instruction_overlay": {
              "type": "string",
              "description": "Instruction appended to ALL workers in this step (e.g., 'Be concise')."
            },
            "workers": {
              "type": "array",
              "description": "Explicit list of workers. Mutually exclusive with perspective_matrix.",
              "items": {
                "type": "object",
                "required": ["worker_id", "model_ref"],
                "properties": {
                  "worker_id": { "type": "string" },
                  "model_ref": { "type": "string", "description": "Key pointing to the actual model client (e.g., 'gpt-4-turbo')." },
                  "instruction": { "type": "string", "description": "Instruction for what this worker should analyze/predict (preferred)." },
                  "role_definition": { "type": "string", "description": "DEPRECATED: Use 'instruction' instead. System prompt specific to this worker." }
                }
              }
            },
            "perspective_matrix": {
              "type": "object",
              "description": "Auto-generate workers as cartesian product of models × perspectives. Mutually exclusive with workers.",
              "required": ["perspectives"],
              "properties": {
                "models": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "DEPRECATED: Specify models at workflow level instead. Explicit model list for this step (overrides workflow.models)."
                },
                "use_models": {
                  "type": "string",
                  "enum": ["all", "whitelist", "blacklist"],
                  "default": "all",
                  "description": "How to select models: 'all' uses workflow.models, 'whitelist' uses only models_filter, 'blacklist' excludes models_filter"
                },
                "models_filter": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Model filter list (used with use_models=whitelist or blacklist)"
                },
                "perspectives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["perspective_id", "instruction"],
                    "properties": {
                      "perspective_id": { "type": "string", "description": "Unique identifier for this perspective (e.g., 'security_analysis')" },
                      "instruction": { "type": "string", "description": "What to analyze/predict from this perspective" }
                    }
                  }
                }
              }
            }
          }
        },

        "// PHASE 2": { "description": "---------------- MIDDLEWARE ----------------" },
        "middleware_phase": {
          "type": "array",
          "description": "Pipeline of operations applied to worker outputs before the Reducer sees them.",
          "items": {
            "type": "object",
            "required": ["op", "apply_to"],
            "properties": {
              "apply_to": {
                "type": "array",
                "items": { "type": "string" },
                "description": "List of worker_ids to apply this to, or ['*'] for all."
              },
              "op": {
                "type": "string",
                "enum": ["filter_regex", "anonymize_pii", "llm_refine", "truncate"]
              },
              "config": {
                "type": "object",
                "description": "Polymorphic configuration based on 'op'."
}
            },
            "allOf": [
              {
                "if": { "properties": { "op": { "const": "filter_regex" } } },
                "then": {
                  "properties": {
                    "config": {
                      "required": ["pattern", "action"],
                      "properties": {
                        "pattern": { "type": "string", "format": "regex" },
                        "action": { "type": "string", "enum": ["drop", "flag"] }
                      }
                    }
                  }
                }
              },
              {
                "if": { "properties": { "op": { "const": "llm_refine" } } },
                "then": {
                  "properties": {
                    "config": {
                      "required": ["model_ref", "instruction"],
                      "properties": {
                        "model_ref": { "type": "string" },
                        "instruction": { "type": "string", "description": "e.g., 'Make tone neutral'" }
                      }
                    }
                  }
                }
              }
            ]
          }
        },

        "// PHASE 3": { "description": "---------------- REDUCE (BARRIER) ----------------" },
        "reduce_phase": {
          "type": "object",
          "required": ["strategy", "model_ref", "output_write_to", "visibility"],
          "properties": {
            "model_ref": { "type": "string" },
            "timeout_ms": { "type": "integer", "default": 30000 },
            "output_write_to": { 
              "type": "string", 
              "description": "Name of the variable to update with the result." 
            },
            "strategy": {
              "type": "string",
              "enum": ["council_chairman", "simple_summary", "vote_majority", "subquery_single_model", "cross_interrogation"]
            },
            "variable_interpolation": {
              "type": "boolean",
              "description": "Enable ${variable_name} interpolation in chairman_instructions and global_instruction_overlay.",
              "default": false
            },
            "visibility": {
              "type": "object",
              "description": "Strict controls on what the Reducer is allowed to see.",
              "properties": {
                "include_original_input": { "type": "boolean" },
                "mask_worker_identities": {
                  "type": "boolean",
                  "description": "If true, 'Legal Bot' becomes 'Argument 1' (Blind Review)."
                },
                "include_rejected_items": {
                  "type": "boolean",
                  "description": "Should the chairman see items dropped by middleware?"
                },
                "include_conversation_history": {
                  "type": "boolean",
                  "description": "If false, only sends current query without any prior context (clean subquery)."
                },
                "include_worker_outputs": {
                  "type": "boolean",
                  "description": "If false, reducer ignores worker outputs (for single-model subqueries)."
                }
              }
            },
            "chairman_instructions": {
              "type": "string",
              "description": "Specific logic for the decision maker (e.g., 'Side with security if risk > low')."
            }
          }
        }
      }
    }
  }
}