# Test environment configuration
# This file is used for E2E testing

# Environment mode
ENVIRONMENT=local

# Authentication (test values - NOT for production)
JWT_SECRET_KEY=test-secret-key-for-e2e-testing-only-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (disabled for faster tests)
ENCRYPTION_ENABLED=false

# OpenRouter API (not used - tests use mocked responses)
# OPENROUTER_API_KEY=your-key-here

# Backend server
BACKEND_PORT=8003

# Frontend dev server
FRONTEND_PORT=5173

# Default profile
DEFAULT_PROFILE_ID=default

# Data directories (will be overridden by test fixtures)
DATA_DIR=./data_test
